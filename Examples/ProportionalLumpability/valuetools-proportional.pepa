gamma1 = 1.0;
gamma2 = 2.0; 
gamma3 = 3.0; 

beta1 = 1.0; 
beta2 = 2.0; 
beta3 = 3.0;


M1 = (m1, gamma1).M1 + (m2, T).V1 + (m3, T).V1;
M2 = (m2, gamma2).M2 + (m1, T).V2 + (m3, T).V2;
M3 = (m3, gamma3).M3 + (m1, T).V3 + (m2, T).V3;

V1 = (v2, beta2).M1 + (v3, beta3).M1 + (m2, T).V1 + (m3, T).V1;
V2 = (v1, beta1).M2 + (v3, beta3).M2 + (m1, T).V2 + (m3, T).V2;
V3 = (v1, beta1).M3 + (v2, beta2).M3 + (m1, T).V3 + (m2, T).V3;

